# Copy to .env (make setup does this). Never commit .env.
PAYLINEAGE_ENV=dev
DATABASE_URL=postgresql+psycopg://paylineage:paylineage_dev@localhost:5432/paylineage
TEST_DATABASE_URL=postgresql+psycopg://paylineage:paylineage_dev@localhost:5432/paylineage_test

# Policy runtime. Leave POLICY_RUNTIME=wasm. The OPA server fallback needs all three:
# POLICY_RUNTIME=opa-server, OPA_SERVER_URL and POLICY_SHA256 equal to policy/dist/policy.sha256.
POLICY_RUNTIME=wasm
# POLICY_SHA256=
# OPA_SERVER_URL=http://localhost:8181

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# Keyed hash for account tokens; never rotate without re-tokenizing the vault.
VAULT_PEPPER=change-me-vault
# Mail gateway token for POST /v1/inbound/email
INGEST_TOKEN=change-me-ingest
EXECUTOR_TOKEN=change-me-executor
MOCKBANK_TOKEN=change-me-mockbank

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Ed25519 private key for audit checkpoints. Keep it outside the database host in production.
AUDIT_CHECKPOINT_KEY_PATH=var/keys/checkpoint_ed25519.pem

# AI (optional; the app works with no model). deterministic | ollama | adversarial_stub
EXTRACTOR=deterministic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# off | heuristic | model (model needs HF_TOKEN and the gated Llama Prompt Guard 2 licence)
PROMPT_GUARD=heuristic
# HF_TOKEN=
